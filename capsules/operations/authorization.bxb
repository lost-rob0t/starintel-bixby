authorization {
  user {
    oauth2-authorization-code (StarIntel) {
      authorize-endpoint ("{oauth.authorize.url}")
      client-id ("{oauth.client.id}")
      client-secret-key (starintel-operations-client-secret)
      scope ("starintel.read starintel.targets.write starintel.autodig.read starintel.autodig.control")
      token-endpoint ("{oauth.token.url}")
    }
  }
}
