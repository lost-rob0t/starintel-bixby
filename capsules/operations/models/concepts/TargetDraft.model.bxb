structure (TargetDraft) {
  description (A normalized target proposal that must be confirmed before commit.)
  features { transaction }
  property (draftId) { type (DraftId) min (Required) max (One) }
  property (subject) { type (TargetSubject) min (Required) max (One) }
  property (targetType) { type (TargetType) min (Required) max (One) }
  property (actor) { type (TargetActor) min (Required) max (One) }
  property (summary) { type (OperationSummary) min (Required) max (One) }
  property (idempotencyKey) { type (IdempotencyKey) min (Required) max (One) }
  property (correlationId) { type (CorrelationId) min (Required) max (One) }
}
