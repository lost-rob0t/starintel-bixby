capsule {
  id (playground.starintelOperations)
  version (0.1.0)
  format (3)
  runtime-version (9) {
    js-runtime-version (2)
  }
  targets {
    target (bixby-mobile-en-US)
  }
  capsule-imports {
    import (viv.core) {
      as (core)
    }
    import (viv.time) {
      as (time)
    }
  }
}
