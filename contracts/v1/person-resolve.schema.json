{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarIntel Bixby Person Resolve Response v1",
  "type": "object",
  "required": ["api_version", "correlation_id", "status"],
  "properties": {
    "api_version": {"const": "v1"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["ok", "ambiguous", "error"]},
    "person": {"$ref": "#/$defs/personProfile"},
    "matches": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/personMatch"}
    },
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {"required": ["person"], "not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"status": {"const": "ambiguous"}}, "required": ["status"]},
      "then": {
        "required": ["matches"],
        "properties": {"matches": {"minItems": 2}},
        "not": {"required": ["person", "error"]}
      }
    },
    {
      "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
      "then": {"required": ["error"], "not": {"required": ["person"]}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "personProfile": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "aliases": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
        "summary": {"type": "string", "maxLength": 2000},
        "role": {"type": "string", "maxLength": 512},
        "organization": {"type": "string", "maxLength": 512},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "supporting_records": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}}
      },
      "additionalProperties": false
    },
    "personMatch": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "aliases": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
        "summary": {"type": "string", "maxLength": 1000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "PERSON_NOT_FOUND",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "INVALID_REQUEST",
            "RATE_LIMITED",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  }
}
